# cronview demo jobs — every command is a harmless no-op.
# Installed with: crontab examples/demo.crontab
# Remove everything with: crontab -r

# Weekday business hours: a dense stripe, 9–17 Mon–Fri
*/10 9-17 * * 1-5 echo 'sync work calendar' > /dev/null

# Weekday mornings
0 7 * * 1-5 echo 'morning report' > /dev/null

# Mon/Wed/Fri evenings
30 19 * * 1,3,5 echo 'gym reminder' > /dev/null

# Every night
0 22 * * * echo 'nightly backup' > /dev/null

# Sunday small hours
15 3 * * 0 echo 'weekly cleanup' > /dev/null

# First of the month
0 0 1 * * echo 'monthly invoice run' > /dev/null

# The 15th, lunchtime
45 12 15 * * echo 'mid-month metrics' > /dev/null

# Weekends, every 4 hours
0 */4 * * 6,0 echo 'weekend health check' > /dev/null

# Alias + boot examples
@daily echo 'rotate logs' > /dev/null
@reboot echo 'start agent' > /dev/null
