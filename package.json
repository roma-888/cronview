{
  "name": "cronview",
  "version": "0.4.0",
  "description": "Terminal calendar viewer for your cron jobs — see when everything runs in a month or week view",
  "type": "module",
  "bin": {
    "cronview": "src/index.tsx"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun src/index.tsx",
    "demo": "bun src/index.tsx --file examples/sample.crontab",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cron",
    "crontab",
    "calendar",
    "tui",
    "terminal",
    "opentui"
  ],
  "license": "MIT",
  "dependencies": {
    "@opentui/core": "^0.4.0",
    "@opentui/react": "^0.4.0",
    "cron-parser": "^5.5.0",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "bun": "^1.3.0",
    "typescript": "^5.9.3"
  }
}
